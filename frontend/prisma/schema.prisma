// Hilunia - Schema Prisma
// SQLite pour le dev, PostgreSQL pour la production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// UTILISATEURS & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  emailVerified DateTime?
  phoneVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Économie
  goldCoins     Int       @default(300)
  diamonds      Int       @default(0)
  gameTokens    Int       @default(0)

  // VIP
  vipLevel      String    @default("NONE")
  vipExpiresAt  DateTime?

  // Vérification
  selfieVerified Boolean  @default(false)
  selfieUrl      String?
  idVerified     Boolean  @default(false)

  // Statut
  isAdmin        Boolean  @default(false)
  isBanned       Boolean  @default(false)
  banReason      String?
  isOnline       Boolean  @default(false)
  lastSeenAt     DateTime @default(now())

  // Progression
  level          Int      @default(1)
  xp             Int      @default(0)

  // Bonus trackés
  bonusProfileDone    Boolean @default(false)
  bonusSelfieDone     Boolean @default(false)
  bonusFirstMoment    Boolean @default(false)
  bonusFirstMatch     Boolean @default(false)
  lastDailyBonus      DateTime?

  // Relations
  profile           Profile?
  sessions          Session[]
  accounts          Account[]
  verificationTokens VerificationToken[]

  sentMessages      Message[]    @relation("SentMessages")
  receivedMessages  Message[]    @relation("ReceivedMessages")

  likesGiven        Like[]       @relation("LikesGiven")
  likesReceived     Like[]       @relation("LikesReceived")

  moments           Moment[]
  momentLikes       MomentLike[]
  momentComments    MomentComment[]
  momentViews       MomentView[]

  giftsSent         Gift[]       @relation("GiftsSent")
  giftsReceived     Gift[]       @relation("GiftsReceived")

  reportsMade       Report[]     @relation("ReportsMade")
  reportsReceived   Report[]     @relation("ReportsReceived")

  coinTransactions  CoinTransaction[]

  rooms             RoomMember[]
  messages          ChatMessage[]

  conversationsA    Conversation[] @relation("ConversationUser1")
  conversationsB    Conversation[] @relation("ConversationUser2")
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  birthDate    DateTime
  gender       String   // MALE | FEMALE | NON_BINARY | OTHER

  interestedIn String   @default("BOTH") // MALE | FEMALE | BOTH | ALL

  bio          String?
  city         String?
  country      String?
  countryCode  String?
  latitude     Float?
  longitude    Float?

  height       Int?
  goal         String?  // FRIENDSHIP | CASUAL | SERIOUS | NETWORKING

  languages    String   @default("[]") // JSON array
  interests    String   @default("[]") // JSON array

  isComplete   Boolean  @default(false)
  lastActiveAt DateTime @default(now())

  photos       ProfilePhoto[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProfilePhoto {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================================
// MATCHING
// ============================================================

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("LikesGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id])
  type       String   @default("LIKE") // LIKE | SUPER_LIKE | PASS
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Match {
  id           String       @id @default(cuid())
  user1Id      String
  user2Id      String
  createdAt    DateTime     @default(now())
  isActive     Boolean      @default(true)
  conversation Conversation?

  @@unique([user1Id, user2Id])
}

// ============================================================
// MESSAGES
// ============================================================

model Conversation {
  id        String   @id @default(cuid())
  matchId   String?  @unique
  match     Match?   @relation(fields: [matchId], references: [id])
  user1Id   String
  user1     User     @relation("ConversationUser1", fields: [user1Id], references: [id])
  user2Id   String
  user2     User     @relation("ConversationUser2", fields: [user2Id], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([user1Id, user2Id])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  receiverId     String
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content        String
  type           String       @default("TEXT") // TEXT | IMAGE | VIDEO | AUDIO | GIFT | VOICE_NOTE | STICKER
  mediaUrl       String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  deletedAt      DateTime?
  replyToId      String?
  createdAt      DateTime     @default(now())
}

// ============================================================
// MOMENTS (posts/stories)
// ============================================================

model Moment {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  mediaUrl    String
  mediaType   String         // IMAGE | VIDEO
  caption     String?
  likes       MomentLike[]
  comments    MomentComment[]
  views       MomentView[]
  viewCount   Int            @default(0)
  likeCount   Int            @default(0)
  commentCount Int           @default(0)
  isArchived  Boolean        @default(false)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model MomentLike {
  id       String   @id @default(cuid())
  momentId String
  moment   Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([momentId, userId])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model MomentView {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([momentId, userId])
}

// ============================================================
// SALONS VOCAUX
// ============================================================

model ChatRoom {
  id          String       @id @default(cuid())
  hostId      String
  name        String
  description String?
  category    String       @default("SOCIAL") // SOCIAL | MUSIC | GAMES | DATING | LEARNING
  language    String       @default("fr")
  coverUrl    String?
  isPrivate   Boolean      @default(false)
  maxMembers  Int          @default(20)
  isActive    Boolean      @default(true)
  members     RoomMember[]
  messages    ChatMessage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("LISTENER") // HOST | CO_HOST | SPEAKER | LISTENER
  isMuted   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@unique([roomId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  type      String   @default("TEXT")
  createdAt DateTime @default(now())
}

// ============================================================
// CADEAUX
// ============================================================

model Gift {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("GiftsSent", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("GiftsReceived", fields: [toUserId], references: [id])
  giftId     String   // identifiant du cadeau (rose, heart, etc.)
  coinsCost  Int
  message    String?
  context    String?  // MESSAGE | MOMENT | ROOM
  createdAt  DateTime @default(now())
}

// ============================================================
// ÉCONOMIE
// ============================================================

model CoinTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int      // positif = crédit, négatif = débit
  type        String   // voir CoinTransactionType
  description String
  metadata    String?  // JSON
  balanceAfter Int
  createdAt   DateTime @default(now())
}

model DiamondTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  description String
  balanceAfter Int
  createdAt   DateTime @default(now())
}

// ============================================================
// MODÉRATION
// ============================================================

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedId   String
  reported     User     @relation("ReportsReceived", fields: [reportedId], references: [id])
  reason       String   // FAKE_PROFILE | SPAM | HARASSMENT | SCAM | INAPPROPRIATE | OTHER
  description  String?
  status       String   @default("PENDING") // PENDING | REVIEWED | RESOLVED | DISMISSED
  evidence     String?  // URL screenshot
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  resolvedAt   DateTime?
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ============================================================
// AUTH (NextAuth)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  type       String   @default("EMAIL") // EMAIL | PHONE | PASSWORD_RESET
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}
